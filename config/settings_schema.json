[
  {
    "name": "theme_info",
    "theme_name": "Pure Source",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Couleurs",
    "settings": [
      { "type": "header", "content": "G\u00e9n\u00e9ral" },
      { "type": "color", "id": "color_background", "label": "Arri\u00e8re-plan", "default": "#FFFFFF" },
      { "type": "color", "id": "color_background_alt", "label": "Arri\u00e8re-plan secondaire (sections altern\u00e9es)", "default": "#F4F1EA" },
      { "type": "color", "id": "color_text", "label": "Texte", "default": "#1D2B36" },
      { "type": "color", "id": "color_text_muted", "label": "Texte secondaire", "default": "#5B6770" },
      { "type": "color", "id": "color_border", "label": "Bordures", "default": "#E3DED3" },
      { "type": "header", "content": "Boutons et accents" },
      { "type": "color", "id": "color_primary", "label": "Couleur principale (boutons)", "default": "#1F4E5F" },
      { "type": "color", "id": "color_primary_text", "label": "Texte des boutons principaux", "default": "#FFFFFF" },
      { "type": "color", "id": "color_accent", "label": "Couleur d'accent (badges, surlignage)", "default": "#E8A33D" },
      { "type": "color", "id": "color_accent_text", "label": "Texte sur l'accent", "default": "#1D2B36" },
      { "type": "color", "id": "color_sale", "label": "Prix sold\u00e9 / promo", "default": "#C8452C" },
      { "type": "color", "id": "color_stars", "label": "\u00c9toiles d'avis", "default": "#F2B01E" },
      { "type": "color", "id": "color_success", "label": "Succ\u00e8s / en stock", "default": "#2E8B57" }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "label": "Police des titres", "default": "poppins_n6" },
      { "type": "range", "id": "heading_scale", "label": "Taille des titres", "min": 80, "max": 140, "step": 5, "unit": "%", "default": 100 },
      { "type": "font_picker", "id": "type_body_font", "label": "Police du texte", "default": "inter_n4" },
      { "type": "range", "id": "body_scale", "label": "Taille du texte", "min": 85, "max": 125, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Largeur de page", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1240 },
      { "type": "range", "id": "button_radius", "label": "Arrondi des boutons", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 },
      { "type": "range", "id": "card_radius", "label": "Arrondi des cartes et images", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
      { "type": "checkbox", "id": "animations", "label": "Animations d'apparition au d\u00e9filement", "default": true }
    ]
  },
  {
    "name": "Produits",
    "settings": [
      { "type": "checkbox", "id": "show_sale_badge", "label": "Afficher le badge promo", "default": true },
      { "type": "select", "id": "sale_badge_style", "label": "Style du badge promo", "options": [
        { "value": "percent", "label": "Pourcentage (-40 %)" },
        { "value": "amount", "label": "Montant (-20 \u20ac)" },
        { "value": "text", "label": "Texte (Promo)" }
      ], "default": "percent" },
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Afficher la 2e image au survol", "default": true },
      { "type": "checkbox", "id": "card_show_rating", "label": "Afficher les \u00e9toiles sur les cartes produit", "default": true },
      { "type": "text", "id": "card_rating_value", "label": "Note affich\u00e9e", "default": "4.8", "info": "Utilis\u00e9 si le produit n'a pas de m\u00e9tachamp reviews.rating (ex. application d'avis)." },
      { "type": "text", "id": "card_rating_count", "label": "Nombre d'avis affich\u00e9", "default": "2 400+" }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Type de panier", "options": [
        { "value": "drawer", "label": "Tiroir lat\u00e9ral" },
        { "value": "page", "label": "Page panier" }
      ], "default": "drawer" },
      { "type": "checkbox", "id": "cart_free_shipping_bar", "label": "Barre de progression livraison gratuite", "default": true },
      { "type": "number", "id": "cart_free_shipping_threshold", "label": "Seuil de livraison gratuite", "default": 50, "info": "Dans la devise de la boutique. Mettez 0 pour toujours afficher \u00ab Livraison gratuite \u00bb." },
      { "type": "checkbox", "id": "cart_show_note", "label": "Activer la note de commande", "default": false },
      { "type": "richtext", "id": "cart_trust_text", "label": "Texte de r\u00e9assurance sous le bouton", "default": "<p>Paiement 100 % sécurisé · Satisfait ou remboursé</p>" }
    ]
  },
  {
    "name": "R\u00e9seaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "placeholder": "https://instagram.com/..." },
      { "type": "text", "id": "social_facebook", "label": "Facebook", "placeholder": "https://facebook.com/..." },
      { "type": "text", "id": "social_tiktok", "label": "TikTok", "placeholder": "https://tiktok.com/@..." },
      { "type": "text", "id": "social_youtube", "label": "YouTube", "placeholder": "https://youtube.com/..." },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest", "placeholder": "https://pinterest.com/..." },
      { "type": "text", "id": "social_x", "label": "X / Twitter", "placeholder": "https://x.com/..." }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Image du favicon", "info": "32 \u00d7 32 px recommand\u00e9" }
    ]
  }
]
