<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      :root { --c-primary: {{ settings.color_primary }}; --c-primary-2: {{ settings.color_primary_light }}; --c-bg: {{ settings.color_background }}; --c-cream: {{ settings.color_cream }}; --c-text: {{ settings.color_text }}; --c-accent: {{ settings.color_accent }}; --c-muted: {{ settings.color_text | color_modify: 'alpha', 0.72 }}; --c-border: {{ settings.color_text | color_modify: 'alpha', 0.14 }}; --radius: {{ settings.radius }}px; --page-width: {{ settings.page_width }}px; }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
