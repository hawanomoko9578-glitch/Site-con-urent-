<section class="section">
  <div class="page-width customer customer--wide">
    <p><a href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a></p>
    <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="text-center text-muted">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}<p class="form-message form-message--error">{{ 'customer.order.cancelled' | t }}</p>{%- endif -%}
    <table>
      <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title | link_to: line_item.product.url }}{% if line_item.fulfillment %}<br><small>{{ line_item.fulfillment.tracking_company }} {{ line_item.fulfillment.tracking_number }}</small>{% endif %}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="3">{{ 'sections.cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="3">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
        {%- for tax_line in order.tax_lines -%}<tr><td colspan="3">{{ tax_line.title }} ({{ tax_line.rate_percentage }} %)</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
        <tr><td colspan="3"><strong>{{ 'customer.orders.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_with_currency }}</strong></td></tr>
      </tfoot>
    </table>
    <div class="customer-grid" style="margin-top:3.2rem">
      <div><h2 class="h4">{{ 'customer.order.billing' | t }}</h2>{{ order.billing_address | format_address }}</div>
      <div><h2 class="h4">{{ 'customer.order.shipping' | t }}</h2>{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Commande", "settings": [] }
{% endschema %}
