{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    {% render 'section-heading', section: section %}
    <ul class="product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index, show_quick_add: section.settings.quick_add %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if section.settings.view_all and section.settings.collection != blank -%}
      <p class="text-center" style="margin-top:3.2rem">
        <a href="{{ section.settings.collection.url }}" class="button button--secondary">{{ 'sections.featured_collection.view_all' | t }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "settings": [
    {"type": "header", "content": "En-tête de section"},
    {"type": "text", "id": "subheading", "label": "Sur-titre"},
    {"type": "text", "id": "heading", "label": "Titre", "default": "Titre de la section"},
    {"type": "richtext", "id": "description", "label": "Description"},
    {"type": "select", "id": "heading_align", "label": "Alignement du titre", "options": [{"value": "center", "label": "Centré"}, {"value": "left", "label": "Gauche"}], "default": "center"},
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Colonnes (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "quick_add", "label": "Bouton d'ajout rapide", "default": true },
    { "type": "checkbox", "id": "view_all", "label": "Bouton « Tout voir »", "default": true },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "presets": [{ "name": "Collection en vedette", "settings": { "heading": "Nos produits" } }]
}
{% endschema %}
