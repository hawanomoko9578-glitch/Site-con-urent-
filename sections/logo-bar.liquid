{% render 'section-style', section: section %}
{%- style -%}
  #shopify-section-{{ section.id }} { --logo-height: {{ section.settings.logo_height }}px; --logo-filter: {% if section.settings.grayscale %}grayscale(1){% else %}none{% endif %}; }
{%- endstyle -%}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="logo-bar__label">{{ section.settings.heading }}</p>
    {%- endif -%}
    <ul class="logo-bar__list reveal" role="list">
      {%- for block in section.blocks -%}
        <li class="logo-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank %}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{% endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}
          {%- else -%}
            <span>{{ block.settings.name }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank %}</a>{% endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logos / « Vu dans »",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils parlent de nous" },
    { "type": "range", "id": "logo_height", "label": "Hauteur des logos", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "checkbox", "id": "grayscale", "label": "Logos en noir et blanc", "default": true },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32}
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "name", "label": "Nom (affiché si pas d'image)", "default": "Magazine" },
      { "type": "url", "id": "link", "label": "Lien" }
    ]}
  ],
  "presets": [{ "name": "Logos / « Vu dans »", "blocks": [
    { "type": "logo", "settings": { "name": "Magazine Animaux" } },
    { "type": "logo", "settings": { "name": "Le Journal Véto" } },
    { "type": "logo", "settings": { "name": "Maison & Chien" } },
    { "type": "logo", "settings": { "name": "Chat Mag" } }
  ]}]
}
{% endschema %}
