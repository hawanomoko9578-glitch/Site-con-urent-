<section class="standards section-pad dark">
  <div class="page-width standards__grid">
    <div class="standards__media">
      {% render 'media', image: section.settings.image, placeholder: 'lifestyle-1', sizes: '(min-width: 990px) 50vw, 100vw' %}
    </div>
    <div class="standards__content">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <div class="standards__icons">
        {%- for block in section.blocks -%}
          <div class="standards__item" {{ block.shopify_attributes }}>
            <span class="standards__circle">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 140 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {% render 'icon', name: block.settings.icon %}
              {%- endif -%}
            </span>
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="center standards__cta">
      <a class="btn btn--light btn--pill btn--wide" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Nos standards",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos standards vont au-delà de ceux du secteur" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La santé de votre chien est trop importante pour prendre des raccourcis. C'est pourquoi chaque pièce de notre fontaine a été pensée avec soin.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "ESSAYER AVEC -50 %" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    { "type": "item", "name": "Icône", "limit": 6, "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "options": [
        { "value": "heart", "label": "Cœur" }, { "value": "shield", "label": "Bouclier" }, { "value": "sparkle", "label": "Étincelles" },
        { "value": "drop", "label": "Goutte" }, { "value": "filter", "label": "Filtre" }, { "value": "volume", "label": "Son" }, { "value": "paw", "label": "Patte" }
      ], "default": "heart" },
      { "type": "image_picker", "id": "image", "label": "Image (remplace l'icône)" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Conçu avec des vétérinaires" }
    ] }
  ],
  "presets": [
    {
      "name": "Nos standards",
      "blocks": [
        { "type": "item", "settings": { "icon": "heart", "text": "Conçu avec des vétérinaires" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Structure en acier inoxydable" } },
        { "type": "item", "settings": { "icon": "sparkle", "text": "Facile à nettoyer (5 minutes)" } },
        { "type": "item", "settings": { "icon": "drop", "text": "Jet robinet avec filtration" } }
      ]
    }
  ]
}
{% endschema %}
