<section class="section">
  <div class="page-width customer">
    <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'password.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.activate.confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password"></div>
      <button type="submit" class="button button--primary button--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Nouveau mot de passe", "settings": [] }
{% endschema %}
