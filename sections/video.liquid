{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
    {% render 'section-heading', section: section %}
    <div class="media media--wide reveal">
      {%- if section.settings.video != blank -%}
        {%- if section.settings.autoplay -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1600x' }}
        {%- else -%}
          {{ section.settings.video | video_tag: controls: true, playsinline: true, image_size: '1600x', preload: 'none' }}
        {%- endif -%}
      {%- elsif section.settings.video_url != blank -%}
        <button type="button" class="video-section__poster" data-video-poster aria-label="{{ 'general.play_video' | t }}" style="position:absolute;inset:0">
          {%- if section.settings.cover != blank -%}
            {{ section.settings.cover | image_url: width: 1600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.cover.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="video-section__play"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4v16l13-8z"/></svg></span>
        </button>
        <template>
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="{{ section.settings.heading | escape }}"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="{{ section.settings.heading | escape }}"></iframe>
          {%- endif -%}
        </template>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vidéo",
  "settings": [
    {"type": "header", "content": "En-tête de section"},
    {"type": "text", "id": "subheading", "label": "Sur-titre"},
    {"type": "text", "id": "heading", "label": "Titre", "default": "Titre de la section"},
    {"type": "richtext", "id": "description", "label": "Description"},
    {"type": "select", "id": "heading_align", "label": "Alignement du titre", "options": [{"value": "center", "label": "Centré"}, {"value": "left", "label": "Gauche"}], "default": "center"},
    { "type": "video", "id": "video", "label": "Vidéo hébergée sur Shopify" },
    { "type": "checkbox", "id": "autoplay", "label": "Lecture auto en boucle, sans son", "default": true },
    { "type": "video_url", "id": "video_url", "label": "…ou lien YouTube / Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover", "label": "Image de couverture (YouTube / Vimeo)" },
    { "type": "checkbox", "id": "narrow", "label": "Largeur réduite", "default": true },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "presets": [{ "name": "Vidéo", "settings": { "heading": "Voyez-la en action" } }]
}
{% endschema %}
