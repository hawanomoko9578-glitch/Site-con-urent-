{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    {% render 'section-heading', section: section %}
    <div class="features" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="feature-card reveal" {{ block.shopify_attributes }}>
          <div class="media media--{{ section.settings.ratio }}" style="border-radius:0">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900', alt: block.settings.image.alt | escape }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="feature-card__body">
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <p style="margin-top:1.2rem"><a href="{{ block.settings.link | default: '#' }}" style="font-weight:700">{{ block.settings.link_label }} →</a></p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cartes avec image",
  "settings": [
    {"type": "header", "content": "En-tête de section"},
    {"type": "text", "id": "subheading", "label": "Sur-titre"},
    {"type": "text", "id": "heading", "label": "Titre", "default": "Titre de la section"},
    {"type": "richtext", "id": "description", "label": "Description"},
    {"type": "select", "id": "heading_align", "label": "Alignement du titre", "options": [{"value": "center", "label": "Centré"}, {"value": "left", "label": "Gauche"}], "default": "center"},
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "ratio", "label": "Format des images", "options": [
      { "value": "square", "label": "Carré" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Paysage" }
    ], "default": "landscape" },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "blocks": [
    { "type": "card", "name": "Carte", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Titre de la carte" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Présentez un bénéfice, une étape ou un détail produit.</p>" },
      { "type": "text", "id": "link_label", "label": "Texte du lien" },
      { "type": "url", "id": "link", "label": "Lien" }
    ]}
  ],
  "presets": [{ "name": "Cartes avec image", "settings": { "subheading": "Simple comme bonjour", "heading": "Prête en 3 étapes" }, "blocks": [
    { "type": "card", "settings": { "title": "1. Remplissez", "text": "<p>Versez de l'eau fraîche dans le réservoir.</p>" } },
    { "type": "card", "settings": { "title": "2. Allumez", "text": "<p>Un seul bouton, et l'eau commence à circuler.</p>" } },
    { "type": "card", "settings": { "title": "3. Profitez", "text": "<p>Votre animal boit plus, naturellement.</p>" } }
  ]}]
}
{% endschema %}
