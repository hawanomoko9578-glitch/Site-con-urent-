<section class="section">
  <div class="page-width customer">
    <p><a href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a></p>
    <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div style="padding:1.6rem 0;border-bottom:1px solid var(--color-border)">
          {%- if address == customer.default_address -%}<span class="badge">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
          {{ address | format_address }}
          <details>
            <summary style="cursor:pointer">{{ 'customer.addresses.edit' | t }}</summary>
            {% render 'address-form', form_type: 'edit', address: address %}
          </details>
          <form method="post" action="{{ address.url }}" style="margin-top:.8rem">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="link" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </div>
      {%- endfor -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
    <details style="margin-top:2.4rem">
      <summary class="button button--primary">{{ 'customer.addresses.add' | t }}</summary>
      {% render 'address-form', form_type: 'new', address: customer.new_address %}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Adresses", "settings": [] }
{% endschema %}
