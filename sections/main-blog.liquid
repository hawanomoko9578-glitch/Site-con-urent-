<section class="section-pad page-width">
  <h1 class="h2 center">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid-products">
      {%- for article in blog.articles -%}
        <a class="pcard" href="{{ article.url }}">
          <span class="pcard__media">
            {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </span>
          <span class="pcard__title">{{ article.title }}</span>
          <span class="pcard__price">{{ article.published_at | date: '%d/%m/%Y' }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="pagination center">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
