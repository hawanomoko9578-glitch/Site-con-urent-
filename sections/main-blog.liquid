<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="article-card">
            <div class="media media--landscape">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.image.alt | escape }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="h3">{{ article.title }}</h2>
            <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
