{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="rich-text rich-text--center reveal">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rich-text__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- form 'customer', class: 'newsletter-form', id: 'Newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" style="width:100%">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" style="width:100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input class="input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
        <button type="submit" class="button button--primary">{% if section.settings.button_label != blank %}{{ section.settings.button_label }}{% else %}{{ 'newsletter.button' | t }}{% endif %}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inscription newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "-10 % sur votre première commande" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Inscrivez-vous et recevez nos conseils bien-être et nos offres en avant-première.</p>" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Je m'inscris" },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "presets": [{ "name": "Inscription newsletter" }]
}
{% endschema %}
