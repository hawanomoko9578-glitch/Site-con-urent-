{% render 'section-style', section: section %}
<section class="section">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Contenu de la page",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
