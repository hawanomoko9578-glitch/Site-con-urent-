{%- style -%}
  #shopify-section-{{ section.id }} .marquee { --mq-bg: {{ section.settings.bg }}; --mq-text: {{ section.settings.text }}; --mq-speed: {{ section.settings.speed }}s; }
{%- endstyle -%}
<div class="marquee" role="region" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="marquee__track">
    {%- for n in (1..2) -%}
      <div class="marquee__group"{% if n == 2 %} aria-hidden="true"{% endif %}>
        {%- for i in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="marquee__item" {% if n == 1 and i == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.icon != 'none' %}{% render 'icon', name: block.settings.icon, size: 20 %}{% endif -%}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Texte défilant",
  "settings": [
    { "type": "color", "id": "bg", "label": "Couleur de fond", "default": "#E8A33D" },
    { "type": "color", "id": "text", "label": "Couleur du texte", "default": "#1D2B36" },
    { "type": "range", "id": "speed", "label": "Durée d'un tour (plus grand = plus lent)", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 35 },
    { "type": "text", "id": "aria_label", "label": "Libellé d'accessibilité", "default": "Nos engagements" }
  ],
  "blocks": [
    { "type": "item", "name": "Élément", "settings": [
      { "type": "text", "id": "text", "label": "Texte", "default": "Livraison gratuite" },
      {"type": "select", "id": "icon", "label": "Icône", "options": [{"value": "check", "label": "Coche"}, {"value": "check-circle", "label": "Coche ronde"}, {"value": "truck", "label": "Camion / livraison"}, {"value": "shield", "label": "Bouclier / sécurité"}, {"value": "refresh", "label": "Retour / échange"}, {"value": "heart", "label": "Cœur"}, {"value": "leaf", "label": "Feuille / naturel"}, {"value": "droplet", "label": "Goutte d'eau"}, {"value": "filter", "label": "Filtre"}, {"value": "quiet", "label": "Silencieux"}, {"value": "paw", "label": "Patte"}, {"value": "clock", "label": "Horloge"}, {"value": "gift", "label": "Cadeau"}, {"value": "chat", "label": "Bulle / support"}, {"value": "lock", "label": "Cadenas / paiement"}, {"value": "star", "label": "Étoile"}, {"value": "sparkle", "label": "Étincelle"}, {"value": "award", "label": "Médaille"}, {"value": "battery", "label": "Batterie"}, {"value": "recycle", "label": "Recyclage"}], "default": "check-circle"}
    ]}
  ],
  "presets": [{ "name": "Texte défilant", "blocks": [
    { "type": "item", "settings": { "text": "Livraison gratuite", "icon": "truck" } },
    { "type": "item", "settings": { "text": "Satisfait ou remboursé", "icon": "refresh" } },
    { "type": "item", "settings": { "text": "Recommandé par des vétérinaires", "icon": "award" } },
    { "type": "item", "settings": { "text": "Service client 7j/7", "icon": "chat" } }
  ]}]
}
{% endschema %}
