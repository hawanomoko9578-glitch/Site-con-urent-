{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="page-width">
    {% render 'section-heading', section: section %}
    {%- if section.settings.show_summary -%}
      <div class="reviews-summary">
        {% render 'stars', rating: section.settings.rating, count: section.settings.summary_text, size: 22 %}
      </div>
    {%- endif -%}
    <div class="slider" data-slider data-autoplay="{{ section.settings.autoplay }}">
      <div class="slider__track" style="--cols: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          <article class="review-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="review-card__media">
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 85vw', widths: '350, 500, 700', alt: block.settings.image.alt | escape }}
              </div>
            {%- endif -%}
            <div class="review-card__body">
              {% render 'stars', rating: block.settings.rating, size: 16 %}
              {%- if block.settings.title != blank -%}<h3 class="review-card__title">{{ block.settings.title }}</h3>{%- endif -%}
              <div class="review-card__text rte">{{ block.settings.text }}</div>
              <div class="review-card__author">
                {{ block.settings.author }}
                {%- if block.settings.verified -%}
                  <span class="review-card__verified">{% render 'icon', name: 'check-circle' %} {{ 'sections.testimonials.verified' | t }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > section.settings.columns -%}
        <div class="slider__controls">
          <button type="button" class="slider__btn slider__btn--prev" data-slider-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-right', size: 20 %}</button>
          <button type="button" class="slider__btn" data-slider-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 20 %}</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Témoignages clients",
  "settings": [
    {"type": "header", "content": "En-tête de section"},
    {"type": "text", "id": "subheading", "label": "Sur-titre"},
    {"type": "text", "id": "heading", "label": "Titre", "default": "Titre de la section"},
    {"type": "richtext", "id": "description", "label": "Description"},
    {"type": "select", "id": "heading_align", "label": "Alignement du titre", "options": [{"value": "center", "label": "Centré"}, {"value": "left", "label": "Gauche"}], "default": "center"},
    { "type": "text", "id": "anchor", "label": "Ancre (lien #avis)", "default": "avis" },
    { "type": "checkbox", "id": "show_summary", "label": "Afficher la note globale", "default": true },
    { "type": "range", "id": "rating", "label": "Note globale", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "summary_text", "label": "Texte de la note globale", "default": "4,8/5 · plus de 10 000 avis" },
    { "type": "range", "id": "columns", "label": "Avis visibles (ordinateur)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "autoplay", "label": "Défilement automatique (0 = désactivé)", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 0 },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo (optionnelle)" },
      { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 0.5, "default": 5 },
      { "type": "text", "id": "title", "label": "Titre", "default": "Mon chat adore !" },
      { "type": "richtext", "id": "text", "label": "Avis", "default": "<p>Remplacez ce texte par un véritable avis client.</p>" },
      { "type": "text", "id": "author", "label": "Auteur", "default": "Prénom N." },
      { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": true }
    ]}
  ],
  "presets": [{ "name": "Témoignages clients", "settings": { "subheading": "Avis clients", "heading": "Ils ne reviendraient pas en arrière" }, "blocks": [
    { "type": "review", "settings": { "title": "Enfin, il boit !", "text": "<p>Remplacez ce texte par un véritable avis client. Les avis authentiques rassurent vos visiteurs.</p>", "author": "Camille R." } },
    { "type": "review", "settings": { "title": "Silencieuse et élégante", "text": "<p>Remplacez ce texte par un véritable avis client. Mentionnez un bénéfice précis.</p>", "author": "Julien M." } },
    { "type": "review", "settings": { "title": "Facile à nettoyer", "text": "<p>Remplacez ce texte par un véritable avis client. Ajoutez une photo pour plus d'impact.</p>", "author": "Sophie L." } },
    { "type": "review", "settings": { "title": "Top pour 2 chiens", "text": "<p>Remplacez ce texte par un véritable avis client.</p>", "author": "Marc D." } }
  ]}]
}
{% endschema %}
