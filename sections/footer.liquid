{%- style -%}
  #shopify-section-{{ section.id }} .site-footer { --footer-bg: {{ section.settings.bg }}; --footer-text: {{ section.settings.text }}; --footer-logo-width: {{ section.settings.logo_width }}px; }
{%- endstyle -%}
{%- liquid
  assign cols = section.blocks.size
  for block in section.blocks
    if block.settings.wide
      assign cols = cols | plus: 1
    endif
  endfor
  if cols < 1
    assign cols = 1
  endif
-%}
<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid" style="--cols: {{ cols }};">
      {%- for block in section.blocks -%}
        <div class="site-footer__block{% if block.settings.wide %} site-footer__block--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="site-footer__logo">
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
                {%- else -%}
                  <h2 class="h3">{{ shop.name }}</h2>
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.show_social -%}{% render 'social-icons' %}{%- endif -%}
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
              <ul class="footer-links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
              {%- form 'customer', class: 'newsletter-form', id: 'FooterNewsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success" style="width:100%">{{ 'newsletter.success' | t }}</p>
                {%- endif -%}
                <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                <input class="input" id="FooterNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
                <button type="submit" class="button button--accent button--small">{{ 'newsletter.button' | t }}</button>
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}.
        {% if section.settings.copyright != blank %}{{ section.settings.copyright }}{% endif %}
        {%- if section.settings.show_powered_by %} {{ powered_by_link }}{% endif -%}
      </div>

      {%- if section.settings.show_localization -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'footer-localization' -%}
            {%- if localization.available_countries.size > 1 -%}
              <label class="visually-hidden" for="FooterCountry">{{ 'localization.country' | t }}</label>
              <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <label class="visually-hidden" for="FooterLanguage">{{ 'localization.language' | t }}</label>
              <select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
                {%- endfor -%}
              </select>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_payment -%}
        <ul class="payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "bg", "label": "Couleur de fond", "default": "#1D2B36" },
    { "type": "color", "id": "text", "label": "Couleur du texte", "default": "#FFFFFF" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "copyright", "label": "Texte de copyright", "default": "Tous droits réservés." },
    { "type": "checkbox", "id": "show_payment", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Afficher le sélecteur pays / langue", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "Afficher « Propulsé par Shopify »", "default": false }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (clair de préférence)" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des produits pensés pour la santé et le bien-être de vos compagnons, testés par des milliers de familles.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Afficher les réseaux sociaux", "default": true, "info": "Liens à configurer dans Paramètres du thème > Réseaux sociaux" },
        { "type": "checkbox", "id": "wide", "label": "Colonne large", "default": true }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Liens utiles" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "checkbox", "id": "wide", "label": "Colonne large", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une question ? Notre équipe répond en moins de 24 h.</p><p>contact@votreboutique.com</p>" },
        { "type": "checkbox", "id": "wide", "label": "Colonne large", "default": false }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Restez informé" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Conseils, nouveautés et offres exclusives.</p>" },
        { "type": "checkbox", "id": "wide", "label": "Colonne large", "default": false }
      ]
    }
  ]
}
{% endschema %}
