<section class="stats section-pad dark">
  <div class="page-width center">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="stats__sub">{{ section.settings.text }}</p>{%- endif -%}
    <div class="stats__grid">
      {%- for block in section.blocks -%}
        <div class="stat" {{ block.shopify_attributes }}>
          <span class="stat__num">{{ block.settings.number }}</span>
          <span class="stat__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--light btn--pill btn--wide" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
    {%- if section.settings.disclaimer != blank -%}<p class="stats__note">{{ section.settings.disclaimer }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Chiffres clés",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "La science derrière notre marque" },
    { "type": "text", "id": "text", "label": "Sous-titre", "default": "Voici ce que rapportent les propriétaires après 30 jours d'utilisation*" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "ESSAYER MAINTENANT" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton", "info": "Vide = remonte vers le bouton d'achat" },
    { "type": "textarea", "id": "disclaimer", "label": "Mention", "default": "*Basé sur un sondage auprès de nos clients. Résultats issus des retours clients collectés en 2026." }
  ],
  "blocks": [
    { "type": "stat", "name": "Chiffre", "limit": 6, "settings": [
      { "type": "text", "id": "number", "label": "Chiffre", "default": "97%" },
      { "type": "text", "id": "label", "label": "Texte", "default": "ont remarqué que leur chien boit plus" }
    ] }
  ],
  "presets": [
    {
      "name": "Chiffres clés",
      "blocks": [
        { "type": "stat", "settings": { "number": "97%", "label": "ont remarqué que leur chien boit plus d'eau" } },
        { "type": "stat", "settings": { "number": "99%", "label": "ont constaté plus d'énergie et de bonne humeur" } },
        { "type": "stat", "settings": { "number": "95%", "label": "des chiens l'ont adoptée en 24 heures" } },
        { "type": "stat", "settings": { "number": "95%", "label": "nous recommanderaient à leurs proches" } }
      ]
    }
  ]
}
{% endschema %}
