<section class="vids section-pad dark" data-slider>
  <div class="page-width center">
    <h2 class="h1">{{ section.settings.heading }}</h2>
  </div>
  <div class="page-width">
    <div class="slider-track vids__track" data-slider-track>
      {%- for block in section.blocks -%}
        <div class="vid-card" data-video-card {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}<span class="vid-card__label">{{ block.settings.label }}</span>{%- endif -%}
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: image_size: '600x', playsinline: true, loop: true, muted: false, preload: 'none', class: 'vid-card__video' }}
          {%- else -%}
            {% render 'media', image: block.settings.image, placeholder: 'lifestyle-2', sizes: '260px', class: 'vid-card__video' %}
          {%- endif -%}
          <button type="button" class="vid-card__play" aria-label="Lire la vidéo">{% render 'icon', name: 'play' %}</button>
        </div>
      {%- endfor -%}
    </div>
    <div class="slider-foot">
      <div class="slider-progress"><span data-slider-progress></span></div>
      <div class="slider-nav">
        <button type="button" class="round-btn round-btn--dark" data-slider-prev aria-label="Précédent">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="round-btn round-btn--dark" data-slider-next aria-label="Suivant">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vidéos clients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu'en disent les propriétaires" }
  ],
  "blocks": [
    { "type": "video", "name": "Vidéo", "settings": [
      { "type": "text", "id": "label", "label": "Étiquette", "default": "ESTHÉTIQUE" },
      { "type": "video", "id": "video", "label": "Vidéo (uploadée dans Shopify)" },
      { "type": "image_picker", "id": "image", "label": "Image (si pas de vidéo)" }
    ] }
  ],
  "presets": [
    {
      "name": "Vidéos clients",
      "blocks": [
        { "type": "video", "settings": { "label": "ESTHÉTIQUE" } },
        { "type": "video", "settings": { "label": "FRAÎCHEUR" } },
        { "type": "video", "settings": { "label": "ADIEU LES TOILETTES" } },
        { "type": "video", "settings": { "label": "PRÉFÉRENCE" } },
        { "type": "video", "settings": { "label": "SANS DÉGÂTS" } },
        { "type": "video", "settings": { "label": "ADOPTÉE" } }
      ]
    }
  ]
}
{% endschema %}
