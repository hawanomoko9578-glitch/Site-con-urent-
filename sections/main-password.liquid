<div class="password-page">
  <div class="password-page__inner">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, style: 'width:180px;margin:0 auto 2.4rem' }}
    {%- else -%}
      <p class="h3">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="text-muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}<p class="form-message form-message--success" style="width:100%">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
      <input class="input" id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}">
      <button type="submit" class="button button--primary">{{ 'newsletter.button' | t }}</button>
    {%- endform -%}
    <details>
      <summary style="cursor:pointer">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" style="width:100%">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
        <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
        <button type="submit" class="button button--secondary">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Bientôt disponible" }
  ]
}
{% endschema %}
