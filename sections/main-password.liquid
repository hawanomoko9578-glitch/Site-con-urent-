<section class="section-pad page-width center page-narrow">
  <h1 class="h2">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe">
    <button type="submit" class="btn btn--primary">Entrer</button>
    {%- if form.errors -%}<p>{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
