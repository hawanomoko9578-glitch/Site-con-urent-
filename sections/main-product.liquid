{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign form_id = 'ProductForm-' | append: section.id -%}

<section class="product section-pad section-pad--tight" data-product-section data-section-id="{{ section.id }}">
  <div class="page-width product__grid">

    {%- comment -%} Galerie {%- endcomment -%}
    <div class="product__gallery" data-gallery>
      <div class="gallery__main">
        {%- if section.settings.badge != blank -%}<span class="gallery__badge">{{ section.settings.badge }}</span>{%- endif -%}
        <div class="gallery__track" data-gallery-track>
          {%- for media in product.media -%}
            <div class="gallery__slide" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1500 | image_tag: sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500', loading: img_loading }}
              {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                {{ media | media_tag: image_size: '1500x', autoplay: false, loop: true, controls: true }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="gallery__slide">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="gallery__thumbs-wrap">
        <button type="button" class="gallery__arrow" data-gallery-prev aria-label="Précédent">{% render 'icon', name: 'chevron-left' %}</button>
        <div class="gallery__thumbs" data-gallery-thumbs>
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
            </button>
          {%- else -%}
            {%- for i in (1..4) -%}
              <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</button>
            {%- endfor -%}
          {%- endfor -%}
        </div>
        <button type="button" class="gallery__arrow" data-gallery-next aria-label="Suivant">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>

    {%- comment -%} Infos produit {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'rating' -%}
            <div class="product__rating" {{ block.shopify_attributes }}>
              <span class="stars stars--outline">{% render 'stars' %}</span>
              <span>{{ block.settings.text }}</span>
            </div>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'description' -%}
            <div class="product__desc rte" {{ block.shopify_attributes }}>
              {%- if block.settings.use_product_description and product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="product__price" data-price {{ block.shopify_attributes }}>
              <span data-price-current>{{ current_variant.price | money }}</span>
              <s data-price-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
            </div>

          {%- when 'tags' -%}
            {%- assign tag_lines = block.settings.tags | newline_to_br | split: '<br />' -%}
            <div class="product__tags" {{ block.shopify_attributes }}>
              {%- for t in tag_lines -%}
                {%- assign tt = t | strip -%}
                {%- if tt != blank -%}<span class="pill">{{ tt }}</span>{%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- if product.has_only_default_variant -%}{%- continue -%}{%- endif -%}
            {%- assign subtitles = block.settings.subtitles | split: ',' -%}
            <div class="variant-picker" {{ block.shopify_attributes }}>
              <div class="variant-picker__head">
                <span>{{ block.settings.label }} <strong data-variant-title>{{ current_variant.title | upcase }}</strong></span>
                {%- if block.settings.guide_label != blank -%}<a href="{{ block.settings.guide_link | default: '#' }}">{{ block.settings.guide_label }}</a>{%- endif -%}
              </div>
              {%- if block.settings.divider_text != blank -%}<div class="divider-text"><span>{{ block.settings.divider_text }}</span></div>{%- endif -%}
              <div class="variant-cards" role="radiogroup">
                {%- for variant in product.variants -%}
                  <label class="variant-card{% unless variant.available %} is-disabled{% endunless %}">
                    <input type="radio" name="variant-{{ section.id }}" value="{{ variant.id }}"
                      {% if variant.id == current_variant.id %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-price="{{ variant.price | money }}"
                      data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                      data-title="{{ variant.title | upcase | escape }}"
                      data-available="{{ variant.available }}"
                      {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}>
                    <span class="variant-card__icon">
                      {%- if variant.featured_image -%}
                        {{ variant.featured_image | image_url: width: 120 | image_tag: loading: 'lazy' }}
                      {%- else -%}
                        {% render 'icon', name: 'paw' %}
                      {%- endif -%}
                    </span>
                    <span class="variant-card__text">
                      <strong>{{ variant.title }}</strong>
                      {%- if subtitles[forloop.index0] -%}<small>{{ subtitles[forloop.index0] | strip }}</small>{%- endif -%}
                    </span>
                    <span class="variant-card__price">
                      {{ variant.price | money }}
                      {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" data-buy-anchor {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <button type="submit" name="add" class="btn btn--primary btn--block btn--lg" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>{% if current_variant.available %}{{ block.settings.label }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                </button>
                <p class="product-form__error" data-form-error hidden></p>
              {%- endform -%}
            </div>

          {%- when 'shipping_info' -%}
            <div class="ship-info" {{ block.shopify_attributes }}>
              <span><i class="dot dot--green"></i>{{ block.settings.left_label }} <b>{{ block.settings.left_value }}</b></span>
              <span><i class="dot dot--orange"></i>{{ block.settings.right_label }} <b>{{ block.settings.right_value }}</b></span>
            </div>

          {%- when 'trust_icons' -%}
            <div class="trust-icons" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign k_icon = 'icon_' | append: i -%}
                {%- assign k_img = 'image_' | append: i -%}
                {%- assign k_text = 'text_' | append: i -%}
                {%- if block.settings[k_text] != blank -%}
                  <div class="trust-icons__item">
                    <span class="trust-icons__circle">
                      {%- if block.settings[k_img] != blank -%}
                        {{ block.settings[k_img] | image_url: width: 120 | image_tag: loading: 'lazy' }}
                      {%- else -%}
                        {% render 'icon', name: block.settings[k_icon] %}
                      {%- endif -%}
                    </span>
                    <span>{{ block.settings[k_text] }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'gifts' -%}
            <div class="gifts" {{ block.shopify_attributes }}>
              <p class="gifts__title">{{ block.settings.heading }}</p>
              <div class="gifts__row">
                {%- for i in (1..4) -%}
                  {%- assign k_img = 'image_' | append: i -%}
                  {%- assign k_val = 'value_' | append: i -%}
                  {%- assign k_name = 'name_' | append: i -%}
                  {%- if block.settings[k_name] != blank -%}
                    <div class="gift">
                      <span class="gift__value">{{ block.settings[k_val] }}</span>
                      <span class="gift__img">
                        {%- if block.settings[k_img] != blank -%}
                          {{ block.settings[k_img] | image_url: width: 160 | image_tag: loading: 'lazy' }}
                        {%- else -%}
                          {% render 'icon', name: 'gift' %}
                        {%- endif -%}
                      </span>
                      <span class="gift__name">{{ block.settings[k_name] }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'collapsible' -%}
            <details class="accordion__item accordion__item--product" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}{% render 'icon', name: 'chevron-down' %}</summary>
              <div class="rte accordion__content">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Barre d'achat collante en bas {%- endcomment -%}
{%- if section.settings.sticky_bar -%}
  <div class="sticky-atc" data-sticky-atc hidden>
    <div class="page-width sticky-atc__inner">
      <span class="sticky-atc__title">{{ product.title }}</span>
      <button type="button" class="btn btn--light" data-sticky-go>{{ section.settings.sticky_label }}</button>
    </div>
  </div>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Produit principal",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge sur l'image", "default": "MEILLEURE VENTE" },
    { "type": "checkbox", "id": "sticky_bar", "label": "Barre d'achat collante en bas", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Bouton de la barre collante", "default": "ACHETER" }
  ],
  "blocks": [
    { "type": "rating", "name": "Note", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Noté 4,9/5 (5 439)" }] },
    { "type": "title", "name": "Titre", "limit": 1, "settings": [] },
    { "type": "description", "name": "Description courte", "limit": 1, "settings": [
      { "type": "checkbox", "id": "use_product_description", "label": "Utiliser la description du produit", "default": false },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La fontaine pour animaux la plus saine du marché, avec une stérilisation en acier inoxydable pour un animal en meilleure santé et plus heureux.</p>" }
    ] },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [] },
    { "type": "tags", "name": "Étiquettes (pilules)", "limit": 1, "settings": [
      { "type": "textarea", "id": "tags", "label": "Une étiquette par ligne", "default": "3x plus d'hydratation\nNettoyage en 5 min\nBloque 99 % des bactéries\nUltra silencieux" }
    ] },
    { "type": "variant_picker", "name": "Choix des variantes", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Libellé", "default": "TAILLE :" },
      { "type": "text", "id": "guide_label", "label": "Lien guide des tailles", "default": "GUIDE DES TAILLES" },
      { "type": "url", "id": "guide_link", "label": "URL guide des tailles" },
      { "type": "text", "id": "divider_text", "label": "Texte séparateur", "default": "Choisir la taille" },
      { "type": "text", "id": "subtitles", "label": "Sous-titres des variantes", "info": "Séparés par des virgules, dans l'ordre des variantes. Ex : Fontaine 4L, Fontaine 7L", "default": "Fontaine 4L, Fontaine 7L" }
    ] },
    { "type": "buy_buttons", "name": "Bouton d'achat", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Texte du bouton", "default": "AJOUTER AU PANIER" }
    ] },
    { "type": "shipping_info", "name": "Infos expédition", "limit": 1, "settings": [
      { "type": "text", "id": "left_label", "label": "Gauche : libellé", "default": "EXPÉDIÉ :" },
      { "type": "text", "id": "left_value", "label": "Gauche : valeur", "default": "DEMAIN" },
      { "type": "text", "id": "right_label", "label": "Droite : libellé", "default": "STOCK :" },
      { "type": "text", "id": "right_value", "label": "Droite : valeur", "default": "FAIBLE" }
    ] },
    { "type": "trust_icons", "name": "Icônes de confiance", "limit": 1, "settings": [
      { "type": "select", "id": "icon_1", "label": "Icône 1", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "award", "label": "Médaille" }, { "value": "shield", "label": "Bouclier" }], "default": "truck" },
      { "type": "image_picker", "id": "image_1", "label": "Image 1 (remplace l'icône)" },
      { "type": "text", "id": "text_1", "label": "Texte 1", "default": "Livraison offerte" },
      { "type": "select", "id": "icon_2", "label": "Icône 2", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "award", "label": "Médaille" }, { "value": "shield", "label": "Bouclier" }], "default": "return" },
      { "type": "image_picker", "id": "image_2", "label": "Image 2" },
      { "type": "text", "id": "text_2", "label": "Texte 2", "default": "Retours sous 30 jours" },
      { "type": "select", "id": "icon_3", "label": "Icône 3", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "award", "label": "Médaille" }, { "value": "shield", "label": "Bouclier" }], "default": "award" },
      { "type": "image_picker", "id": "image_3", "label": "Image 3" },
      { "type": "text", "id": "text_3", "label": "Texte 3", "default": "Garantie 1 an" }
    ] },
    { "type": "gifts", "name": "Cadeaux offerts", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "VOS CADEAUX OFFERTS" },
      { "type": "image_picker", "id": "image_1", "label": "Cadeau 1 : image" },
      { "type": "text", "id": "value_1", "label": "Cadeau 1 : valeur", "default": "OFFERT 10 €" },
      { "type": "text", "id": "name_1", "label": "Cadeau 1 : nom", "default": "Kit de nettoyage" },
      { "type": "image_picker", "id": "image_2", "label": "Cadeau 2 : image" },
      { "type": "text", "id": "value_2", "label": "Cadeau 2 : valeur", "default": "OFFERT 24 €" },
      { "type": "text", "id": "name_2", "label": "Cadeau 2 : nom", "default": "Jouets surprise" },
      { "type": "image_picker", "id": "image_3", "label": "Cadeau 3 : image" },
      { "type": "text", "id": "value_3", "label": "Cadeau 3 : valeur", "default": "OFFERT 30 €" },
      { "type": "text", "id": "name_3", "label": "Cadeau 3 : nom", "default": "4 filtres" },
      { "type": "image_picker", "id": "image_4", "label": "Cadeau 4 : image" },
      { "type": "text", "id": "value_4", "label": "Cadeau 4 : valeur", "default": "OFFERT 20 €" },
      { "type": "text", "id": "name_4", "label": "Cadeau 4 : nom", "default": "Garantie 1 an" }
    ] },
    { "type": "collapsible", "name": "Onglet déroulant", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Caractéristiques" },
      { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Votre contenu ici.</p>" },
      { "type": "page", "id": "page", "label": "Ou contenu d'une page" }
    ] },
    { "type": "text", "name": "Texte libre", "settings": [
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Texte libre</p>" }
    ] }
  ]
}
{% endschema %}
