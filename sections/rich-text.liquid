{% render 'section-style', section: section %}
<section class="section section--{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="rich-text rich-text--{{ section.settings.align }} reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}<h2 class="h{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}<div class="rich-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: '#' }}" class="button button--{{ block.settings.style }}">{{ block.settings.label }}</a></div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignement", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }
    ], "default": "center" },
    {"type": "header", "content": "Style de la section"},
    {"type": "select", "id": "color_scheme", "label": "Couleurs", "options": [{"value": "default", "label": "Fond principal"}, {"value": "alt", "label": "Fond secondaire"}, {"value": "dark", "label": "Fond couleur principale (sombre)"}], "default": "default"},
    {"type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64}
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Sur-titre", "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Notre histoire" } ] },
    { "type": "heading", "name": "Titre", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Né de l'amour pour nos animaux" },
      { "type": "select", "id": "size", "label": "Taille", "options": [
        { "value": "1", "label": "Très grand" }, { "value": "2", "label": "Grand" }, { "value": "3", "label": "Moyen" }
      ], "default": "2" }
    ]},
    { "type": "text", "name": "Texte", "settings": [
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Racontez ici l'histoire de votre marque, votre mission et ce qui vous rend différent.</p>" }
    ]},
    { "type": "button", "name": "Bouton", "settings": [
      { "type": "text", "id": "label", "label": "Texte", "default": "Découvrir" },
      { "type": "url", "id": "link", "label": "Lien" },
      { "type": "select", "id": "style", "label": "Style", "options": [
        { "value": "primary", "label": "Principal" }, { "value": "accent", "label": "Accent" }, { "value": "secondary", "label": "Contour" }
      ], "default": "primary" }
    ]}
  ],
  "presets": [{ "name": "Texte enrichi", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" } ] }]
}
{% endschema %}
