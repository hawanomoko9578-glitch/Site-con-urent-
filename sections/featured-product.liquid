{% render 'section-style', section: section %}
{%- liquid
  assign product = section.settings.product
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="section section--{{ section.settings.color_scheme }}"{% if product != blank %} data-product-section{% endif %} id="{{ section.settings.anchor | default: section.id | handleize }}">
  <div class="page-width">
    {% render 'section-heading', section: section %}
    <div class="product">
      <div class="product__media-wrapper">
        {%- if product != blank -%}
          {% render 'product-gallery', product: product, section: section %}
        {%- else -%}
          <div class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>
      <div class="product__info">
        {%- if product != blank -%}
          {%- for block in section.blocks -%}
            {% render 'product-block', block: block, product: product, section: section, form_id: form_id %}
          {%- endfor -%}
        {%- else -%}
          <h2 class="h2">{{ 'sections.featured_product.placeholder_title' | t }}</h2>
          <div class="price price--large"><span class="price__regular">{{ 4999 | money }}</span></div>
          <p class="text-muted">{{ 'sections.featured_product.placeholder_text' | t }}</p>
          <button class="button button--primary button--full button--large" disabled>{{ 'products.product.add_to_cart' | t }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if product != blank -%}
    <script type="application/json" data-product-json>{{ product | json }}</script>
  {%- endif -%}
</section>

