{%- style -%}
  #shopify-section-{{ section.id }} { --header-bg: {{ section.settings.bg }}; --header-text: {{ section.settings.text }}; --logo-width: {{ section.settings.logo_width }}px; }
  {%- if section.settings.sticky -%}
    #shopify-section-{{ section.id }} { position: sticky; top: 0; z-index: 50; }
  {%- endif -%}
{%- endstyle -%}

<header class="site-header site-header--logo-{{ section.settings.logo_position }}">
  <div class="page-width site-header__inner">
    <div class="site-header__left">
      <button type="button" class="header-icon menu-toggle" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
      {%- if section.settings.logo_position == 'center' -%}
        <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
          {% render 'header-menu', menu: section.settings.menu %}
        </nav>
      {%- endif -%}
    </div>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_w2 = section.settings.logo_width | times: 2 -%}
          {{ section.settings.logo | image_url: width: logo_w2 | image_tag: alt: shop.name, width: section.settings.logo_width, height: '' }}
        {%- else -%}
          <span class="h3" style="margin:0">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- if section.settings.logo_position == 'left' -%}
      <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'header-menu', menu: section.settings.menu %}
      </nav>
    {%- endif -%}

    <div class="site-header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="header-icon" data-search-toggle aria-label="{{ 'general.search.title' | t }}">
          {% render 'icon', name: 'search' %}
        </a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-icon header-icon--account" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
      <a
        href="{{ routes.cart_url }}"
        class="header-icon"
        {% if settings.cart_type == 'drawer' and template.name != 'cart' %}data-drawer-open="CartDrawer"{% endif %}
        aria-label="{{ 'sections.cart.title' | t }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div class="search-bar" id="HeaderSearch" hidden>
      <div class="page-width">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input class="input" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}">
          <button type="submit" class="button button--primary button--small">{{ 'general.search.submit' | t }}</button>
        </form>
      </div>
    </div>
  {%- endif -%}
</header>

<div class="drawer drawer--left" id="MenuDrawer" aria-hidden="true">
  <button class="drawer__overlay" type="button" data-drawer-close aria-label="{{ 'general.close' | t }}" tabindex="-1"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="drawer__header">
      <span class="h4" style="margin:0">{{ shop.name }}</span>
      <button type="button" class="header-icon" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      <ul class="mobile-nav" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            {%- if link.links != blank -%}
              <details>
                <summary>{{ link.title }} {% render 'icon', name: 'chevron-down', size: 18 %}</summary>
                <ul role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="button button--secondary button--full">
          {% render 'icon', name: 'account', size: 20 %} {{ 'customer.account.title' | t }}
        </a>
      {%- endif -%}
      {% render 'social-icons' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo", "min": 50, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "select", "id": "logo_position", "label": "Position du logo (ordinateur)", "options": [
      { "value": "left", "label": "À gauche, menu au centre" },
      { "value": "center", "label": "Au centre, menu à gauche" }
    ], "default": "left" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "En-tête fixe au défilement", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Afficher la recherche", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Afficher l'icône compte", "default": true },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#1D2B36" }
  ]
}
{% endschema %}
