<article class="section-pad page-width page-narrow">
  {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: class: 'article__img' }}{%- endif -%}
  <h1 class="h2">{{ article.title }}</h1>
  <p class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }}</p>
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
