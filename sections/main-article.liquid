<article class="section">
  <div class="page-width page-width--narrow">
    <header class="article__header">
      <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p>
      <h1 class="h1">{{ article.title }}</h1>
    </header>
    {%- if article.image -%}
      <div class="media media--adapt article__image">
        {{ article.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 820px) 820px, 100vw', widths: '600, 900, 1200, 1600', alt: article.image.alt | escape }}
      </div>
    {%- endif -%}
    <div class="article__content rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div class="comments">
        <h2 class="h3">{{ 'blogs.comments.title' | t }} ({{ article.comments_count }})</h2>
        {%- paginate article.comments by 20 -%}
          {%- for comment in article.comments -%}
            <div class="comment">
              <div class="rte">{{ comment.content }}</div>
              <p class="article-card__meta">{{ comment.author }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
        {%- form 'new_comment', article -%}
          <h3 class="h4" style="margin-top:2.4rem">{{ 'blogs.comments.leave' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{% if blog.moderated? %}{{ 'blogs.comments.success_moderated' | t }}{% else %}{{ 'blogs.comments.success' | t }}{% endif %}</p>
          {%- endif -%}
          {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label for="CommentAuthor">{{ 'contact.name' | t }}</label><input id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" required></div>
          <div class="field"><label for="CommentEmail">{{ 'contact.email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" required></div>
          <div class="field"><label for="CommentBody">{{ 'contact.message' | t }}</label><textarea id="CommentBody" name="comment[body]" required>{{ form.body }}</textarea></div>
          <button type="submit" class="button button--primary">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
    <p style="margin-top:3.2rem"><a href="{{ blog.url }}">&larr; {{ 'blogs.article.back' | t: title: blog.title }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Afficher l'auteur", "default": false }
  ]
}
{% endschema %}
