<div class="announce" style="--announce-bg: {{ section.settings.bg }}; --announce-fg: {{ section.settings.fg }};">
  {%- if section.settings.link != blank -%}<a class="announce__link" href="{{ section.settings.link }}">{%- endif -%}
  <div class="announce__inner">
    <div class="announce__text">
      <strong class="announce__title">{{ section.settings.title }}</strong>
      {%- if section.settings.subtitle != blank -%}<span class="announce__sub">{{ section.settings.subtitle }}</span>{%- endif -%}
    </div>
    {%- if section.settings.show_countdown -%}
      <div class="countdown" data-countdown data-end="{{ section.settings.end_date }}" data-hours="{{ section.settings.loop_hours }}">
        <div class="countdown__box"><span data-h>00</span><small>HRS</small></div>
        <div class="countdown__box"><span data-m>00</span><small>MIN</small></div>
        <div class="countdown__box"><span data-s>00</span><small>SEC</small></div>
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "Bandeau promo",
  "class": "section-announce",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "SOLDES D'AUTOMNE" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "-50 % + CADEAUX OFFERTS" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "checkbox", "id": "show_countdown", "label": "Afficher le compte à rebours", "default": true },
    { "type": "text", "id": "end_date", "label": "Date de fin (optionnel)", "info": "Format : 2026-12-31T23:59. Laisser vide pour un compte à rebours qui se relance en boucle." },
    { "type": "range", "id": "loop_hours", "label": "Durée de la boucle (si pas de date)", "min": 1, "max": 48, "step": 1, "unit": "h", "default": 2 },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#2F3FD1" },
    { "type": "color", "id": "fg", "label": "Texte", "default": "#FFFFFF" }
  ]
}
{% endschema %}
