{%- style -%}
  #shopify-section-{{ section.id }} .hero { min-height: {{ section.settings.height }}vh; }
  #shopify-section-{{ section.id }} .hero__overlay { background: linear-gradient(90deg, rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }}) 0%, rgba(0,0,0,0) 70%); }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero { min-height: {{ section.settings.height_mobile }}vh; }
  }
{%- endstyle -%}

<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image_mobile != blank -%}
      <div class="hero__img hero__img--mobile">{% render 'media', image: section.settings.image_mobile, sizes: '100vw', eager: true %}</div>
      <div class="hero__img hero__img--desktop">{% render 'media', image: section.settings.image, placeholder: 'hero-apparel-1', sizes: '100vw', eager: true %}</div>
    {%- else -%}
      <div class="hero__img">{% render 'media', image: section.settings.image, placeholder: 'hero-apparel-1', sizes: '100vw', eager: true %}</div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content page-width">
    <h1 class="hero__title">{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif %}</h1>
    {%- if section.settings.subheading != blank -%}<p class="hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.rating_text != blank -%}
      <div class="hero__rating">
        <span class="hero__rating-stars">{% render 'stars' %}</span>
        <span>{{ section.settings.rating_text }}</span>
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--light btn--pill" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right' %}
      </a>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="hero__checks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>&#10003; {{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (ordinateur)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, optionnel)" },
    { "type": "range", "id": "height", "label": "Hauteur (ordinateur)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "range", "id": "height_mobile", "label": "Hauteur (mobile)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "range", "id": "overlay", "label": "Assombrissement à gauche", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une hydratation pensée pour" },
    { "type": "text", "id": "heading_italic", "label": "Mot en italique", "default": "eux" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "La fontaine pour chien n°1." },
    { "type": "text", "id": "rating_text", "label": "Texte de la note", "default": "Noté 4,9/5 par +5 000 clients" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "check",
      "name": "Argument",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Approuvé par les vétos" }]
    }
  ],
  "presets": [
    {
      "name": "Bannière principale",
      "blocks": [
        { "type": "check", "settings": { "text": "Approuvé par les vétos" } },
        { "type": "check", "settings": { "text": "Livraison offerte" } },
        { "type": "check", "settings": { "text": "Garantie 365 jours" } }
      ]
    }
  ]
}
{% endschema %}
