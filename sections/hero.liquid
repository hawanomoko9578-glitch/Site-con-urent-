{%- style -%}
  #shopify-section-{{ section.id }} .hero {
    --hero-height: {{ section.settings.height }}vh;
    --hero-height-mobile: {{ section.settings.height_mobile }}vh;
    --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
    --hero-text: {{ section.settings.text_color }};
    --hero-bg: {{ settings.color_background_alt }};
  }
{%- endstyle -%}
<section class="hero hero--align-{{ section.settings.align }} hero--valign-{{ section.settings.valign }}{% if section.settings.image_mobile != blank %} hero--has-mobile{% endif %}{% if section.settings.mobile_stack %} hero--mobile-stack{% endif %}">
  <div class="hero__media hero__media--desktop">
    {%- if section.settings.image != blank -%}
      {%- assign focal = section.settings.image.presentation.focal_point | prepend: 'object-position: ' -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 1800, 2400', fetchpriority: 'high', loading: 'eager', style: focal, alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if section.settings.image_mobile != blank -%}
    <div class="hero__media hero__media--mobile">
      {{ section.settings.image_mobile | image_url: width: 1100 | image_tag: sizes: '100vw', widths: '550, 750, 1100', loading: 'eager', alt: section.settings.image_mobile.alt | escape }}
    </div>
  {%- endif -%}

  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badge' -%}
            <span class="badge badge--accent hero__badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- when 'rating' -%}
            <div class="hero__stars" {{ block.shopify_attributes }}>
              {% render 'stars', rating: block.settings.rating, count: block.settings.text, size: 18 %}
            </div>
          {%- when 'heading' -%}
            {%- if section.index == 1 -%}
              <h1 class="h1" {{ block.shopify_attributes }} style="font-size: calc(var(--font-heading-scale) * {{ block.settings.size }}rem);">{{ block.settings.heading }}</h1>
            {%- else -%}
              <h2 class="h1" {{ block.shopify_attributes }} style="font-size: calc(var(--font-heading-scale) * {{ block.settings.size }}rem);">{{ block.settings.heading }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="hero__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'bullets' -%}
            <ul class="hero__bullets" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign key = 'bullet_' | append: i -%}
                {%- if block.settings[key] != blank -%}
                  <li>{% render 'icon', name: 'check-circle', size: 22 %} {{ block.settings[key] }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- when 'buttons' -%}
            <div class="hero__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.label_1 != blank -%}
                <a href="{{ block.settings.link_1 | default: routes.all_products_collection_url }}" class="button button--{{ block.settings.style_1 }} button--large">
                  {{ block.settings.label_1 }} {% render 'icon', name: 'arrow-right', size: 20 %}
                </a>
              {%- endif -%}
              {%- if block.settings.label_2 != blank -%}
                <a href="{{ block.settings.link_2 | default: '#' }}" class="button button--secondary button--large">{{ block.settings.label_2 }}</a>
              {%- endif -%}
            </div>
          {%- when 'note' -%}
            <p class="hero__note" style="font-size:1.4rem;opacity:.9" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond (ordinateur)", "info": "2400 × 1200 px recommandé" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (optionnelle)", "info": "1100 × 1400 px recommandé" },
    { "type": "range", "id": "height", "label": "Hauteur (ordinateur)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "height_mobile", "label": "Hauteur (mobile)", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "checkbox", "id": "mobile_stack", "label": "Mobile : texte sous l'image", "default": false },
    { "type": "range", "id": "overlay", "label": "Assombrissement de l'image", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#FFFFFF" },
    { "type": "select", "id": "align", "label": "Alignement horizontal", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "left" },
    { "type": "select", "id": "valign", "label": "Alignement vertical", "options": [
      { "value": "top", "label": "Haut" }, { "value": "middle", "label": "Milieu" }, { "value": "bottom", "label": "Bas" }
    ], "default": "middle" }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "Texte", "default": "Nouveau · Édition 2026" }
    ]},
    { "type": "rating", "name": "Note / avis", "limit": 1, "settings": [
      { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
      { "type": "text", "id": "text", "label": "Texte", "default": "Noté 4,8/5 par plus de 10 000 clients" }
    ]},
    { "type": "heading", "name": "Titre", "limit": 2, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "De l'eau fraîche et filtrée, toute la journée" },
      { "type": "range", "id": "size", "label": "Taille du titre", "min": 3, "max": 8, "step": 0.2, "unit": "rem", "default": 5.2 }
    ]},
    { "type": "text", "name": "Texte", "settings": [
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La fontaine silencieuse qui donne envie à votre animal de boire plus — pour une meilleure hydratation au quotidien.</p>" }
    ]},
    { "type": "bullets", "name": "Liste d'avantages", "limit": 1, "settings": [
      { "type": "text", "id": "bullet_1", "label": "Avantage 1", "default": "Filtration en 3 étapes" },
      { "type": "text", "id": "bullet_2", "label": "Avantage 2", "default": "Pompe ultra-silencieuse" },
      { "type": "text", "id": "bullet_3", "label": "Avantage 3", "default": "Acier inoxydable, sans BPA" },
      { "type": "text", "id": "bullet_4", "label": "Avantage 4" }
    ]},
    { "type": "buttons", "name": "Boutons", "limit": 1, "settings": [
      { "type": "text", "id": "label_1", "label": "Texte du bouton 1", "default": "Découvrir la fontaine" },
      { "type": "url", "id": "link_1", "label": "Lien du bouton 1" },
      { "type": "select", "id": "style_1", "label": "Style du bouton 1", "options": [
        { "value": "primary", "label": "Principal" }, { "value": "accent", "label": "Accent" }
      ], "default": "accent" },
      { "type": "text", "id": "label_2", "label": "Texte du bouton 2" },
      { "type": "url", "id": "link_2", "label": "Lien du bouton 2" }
    ]},
    { "type": "note", "name": "Petite note", "limit": 1, "settings": [
      { "type": "text", "id": "text", "label": "Texte", "default": "Livraison gratuite · Garantie satisfait ou remboursé" }
    ]}
  ],
  "presets": [
    {
      "name": "Bannière principale",
      "blocks": [
        { "type": "rating" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "bullets" },
        { "type": "buttons" },
        { "type": "note" }
      ]
    }
  ]
}
{% endschema %}
