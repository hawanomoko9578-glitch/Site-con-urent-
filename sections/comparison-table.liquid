<section class="compare">
  <div class="compare__bg">
    {% render 'media', image: section.settings.background, placeholder: 'hero-apparel-2', sizes: '100vw' %}
  </div>
  <div class="page-width compare__wrap">
    <div class="compare__card">
      <table class="compare__table">
        <thead>
          <tr>
            <th class="compare__label">{{ section.settings.heading }}</th>
            <th class="compare__us">
              {%- if section.settings.logo != blank -%}
                {{ section.settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.us_label }}
              {%- else -%}
                <span class="compare__us-name">{{ section.settings.us_label }}</span>
              {%- endif -%}
            </th>
            <th>{{ section.settings.col2_label }}</th>
            <th>{{ section.settings.col3_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="compare__label">{{ block.settings.label }}</th>
              <td class="compare__us">{% render 'compare-cell', value: block.settings.us %}</td>
              <td>{% render 'compare-cell', value: block.settings.col2 %}</td>
              <td>{% render 'compare-cell', value: block.settings.col3 %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tableau comparatif",
  "settings": [
    { "type": "image_picker", "id": "background", "label": "Image de fond" },
    { "type": "text", "id": "heading", "label": "Titre (coin haut gauche)", "default": "NOUS VS. LES AUTRES" },
    { "type": "image_picker", "id": "logo", "label": "Votre logo (version blanche)" },
    { "type": "text", "id": "us_label", "label": "Votre nom (si pas de logo)", "default": "MA MARQUE" },
    { "type": "text", "id": "col2_label", "label": "Colonne 2", "default": "AUTRES FONTAINES" },
    { "type": "text", "id": "col3_label", "label": "Colonne 3", "default": "GAMELLES" }
  ],
  "blocks": [
    { "type": "row", "name": "Ligne", "settings": [
      { "type": "paragraph", "content": "Dans chaque case, tapez « oui » pour ✓, « non » pour ✕, « ? » pour un point d'interrogation, ou n'importe quel autre texte." },
      { "type": "text", "id": "label", "label": "Critère", "default": "FACILE À NETTOYER" },
      { "type": "text", "id": "us", "label": "Vous", "default": "oui" },
      { "type": "text", "id": "col2", "label": "Colonne 2", "default": "non" },
      { "type": "text", "id": "col3", "label": "Colonne 3", "default": "non" }
    ] }
  ],
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "label": "MATÉRIAU", "us": "INOX QUALITÉ MÉDICALE", "col2": "?", "col3": "?" } },
        { "type": "row", "settings": { "label": "FILTRATION", "us": "TRIPLE COUCHE", "col2": "SIMPLE OU AUCUNE", "col3": "non" } },
        { "type": "row", "settings": { "label": "BRUIT", "us": "ULTRA SILENCIEUX", "col2": "POMPE BRUYANTE", "col3": "non" } },
        { "type": "row", "settings": { "label": "FACILE À NETTOYER", "us": "oui", "col2": "non", "col3": "non" } },
        { "type": "row", "settings": { "label": "JET ROBINET", "us": "oui", "col2": "non", "col3": "non" } },
        { "type": "row", "settings": { "label": "CONÇU POUR DURER", "us": "oui", "col2": "non", "col3": "?" } }
      ]
    }
  ]
}
{% endschema %}
