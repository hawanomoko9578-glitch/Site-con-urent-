{% render 'section-style', section: section %}
<section class="section">
  <div class="page-width">
    <div class="collection-hero section-heading">
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="section-heading__text rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="collection-toolbar">
        <p class="text-muted" style="margin:0">{{ 'sections.collection.count' | t: count: collection.products_count }}</p>
        {%- if section.settings.show_sort -%}
          <form method="get">
            <label class="visually-hidden" for="SortBy">{{ 'sections.collection.sort' | t }}</label>
            <select class="select" id="SortBy" name="sort_by" onchange="this.form.submit()">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>
      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
          {%- for product in collection.products -%}
            <li>{% render 'product-card', product: product, index: forloop.index, show_quick_add: section.settings.quick_add %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="text-center">{{ 'sections.collection.empty' | t }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Afficher la description", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Afficher le tri", "default": true },
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 4, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Bouton d'ajout rapide", "default": true },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
