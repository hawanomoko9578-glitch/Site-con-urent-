<section class="pcar section-pad" data-slider>
  <div class="page-width">
    <div class="slider-head">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- else -%}<span></span>{%- endif -%}
      <div class="slider-nav">
        <span class="slider-nav__count" data-slider-count></span>
        <button type="button" class="round-btn" data-slider-prev aria-label="Précédent">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="round-btn" data-slider-next aria-label="Suivant">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
    <div class="slider-track pcar__track" data-slider-track>
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <a class="pcard" href="{{ product.url }}">
            <span class="pcard__type">{{ product.type | default: product.vendor }}</span>
            <span class="pcard__media">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 80vw', widths: '350, 500, 700', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="pcard__title">{{ product.title }}</span>
            <span class="pcard__price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pcard">
            <span class="pcard__type">{% cycle 'ACCESSOIRES', 'PRODUIT PHARE', 'ACCESSOIRES', 'PACK' %}</span>
            <span class="pcard__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span>
            <span class="pcard__title">Nom du produit</span>
            <span class="pcard__price">29,95 €</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Carrousel produits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (optionnel)" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre max de produits", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Carrousel produits" }]
}
{% endschema %}
