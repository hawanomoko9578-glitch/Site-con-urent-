<section class="section-pad page-width">
  <h1 class="h2 center">{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher…" aria-label="{{ 'general.search' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn--primary">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    <div class="grid-products">
      {%- for item in search.results -%}
        <a class="pcard" href="{{ item.url }}">
          <span class="pcard__media">
            {%- if item.featured_image -%}{{ item.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </span>
          <span class="pcard__title">{{ item.title }}</span>
          {%- if item.price -%}<span class="pcard__price">{{ item.price | money }}</span>{%- endif -%}
        </a>
      {%- else -%}
        <p>Aucun résultat pour « {{ search.terms }} ».</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
