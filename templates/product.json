        "b6": {
          "type": "review",
          "settings": {
            "name": "Laura C.",
            "title": "Deuxième commande…",
            "text": "C'est ma deuxième commande. La première tourne depuis 7 mois sans aucun souci, alors j'en ai pris une pour ma sœur. Elle m'a écrit trois jours plus tard : son chien l'adore. Ça marche, tout simplement."
          }
        },
        "b7": {
          "type": "review",
          "settings": {
            "name": "Rachel G.",
            "title": "Vraiment incroyable",
            "text": "Je n'en attendais pas grand-chose. J'avais essayé 2 autres fontaines qui ne marchaient pas ou ont cassé. Trois semaines après, il y boit sans arrêt. Pompe silencieuse, facile à nettoyer."
          }
        },
        "b8": {
          "type": "review",
          "settings": {
            "name": "Karine M.",
            "title": "LE BON CHOIX",
            "text": "Je viens de l'acheter et je ne pourrais pas être plus satisfaite. Très bien construite et, contrairement à d'autres, étonnamment facile à monter. Aucune bactérie jusqu'ici."
          }
        },
        "b9": {
          "type": "review",
          "settings": {
            "name": "Éric C.",
            "title": "J'ai hésité…",
            "text": "J'ai hésité à cause du prix, mais aucun regret ! Luna, notre golden, l'adore. Plus besoin de remplir tous les jours et l'eau est toujours fraîche. Ça vaut l'investissement."
          }
        },
        "b10": {
          "type": "review",
          "settings": {
            "name": "Samuel A.",
            "title": "La meilleure",
            "text": "Nous avions une fontaine en plastique très difficile à nettoyer. Nous sommes passés à celle-ci : super simple à entretenir, l'eau reste fraîche et nos chiens l'adorent !"
          }
        }
      },
