{%- comment -%} Liste des articles du panier. Paramètres : context ('drawer' ou 'page') {%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item">
      <a href="{{ item.url }}" class="cart-item__media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div>
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- unless property.last == blank or property.first contains '_' -%}
            <p class="cart-item__meta">{{ property.first }} : {{ property.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}
        <div class="cart-item__actions">
          <div class="quantity quantity--small">
            <button type="button" data-qty-btn="minus" aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
            <input
              type="number"
              {% if context == 'page' %}name="updates[]"{% endif %}
              value="{{ item.quantity }}"
              min="0"
              data-cart-line-qty
              data-line="{{ forloop.index }}"
              aria-label="{{ 'products.product.quantity' | t }}"
            >
            <button type="button" data-qty-btn="plus" aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
          </div>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">{{ 'sections.cart.remove' | t }}</a>
        </div>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        {{ item.final_line_price | money }}
      </div>
    </li>
  {%- endfor -%}
</ul>
