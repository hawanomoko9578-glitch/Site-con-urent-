{%- comment -%}
  Icônes SVG en ligne. Usage : {% render 'icon', name: 'truck' %}
  Noms disponibles : cart, account, search, menu, close, star, check, truck, shield, refresh,
  heart, leaf, droplet, filter, quiet, paw, clock, gift, chat, lock, arrow-right, chevron-down,
  minus, plus, sparkle, award, battery, recycle, x-circle, check-circle, instagram, facebook,
  tiktok, youtube, pinterest, x
{%- endcomment -%}
{%- assign size = size | default: 24 -%}
{%- case name -%}
  {%- when 'star' -%}
    <svg class="icon icon-star" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95L12 2.5z"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.3-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.6 3c.3 2.2 1.6 3.7 3.9 3.9v2.6c-1.4.1-2.7-.3-3.9-1.1v5.9c0 3.9-3.2 6.2-6.4 5.6-3.3-.6-5-3.9-3.9-6.9.9-2.3 3.2-3.7 5.8-3.4v2.8c-.4-.1-.8-.2-1.2-.1-1.3.1-2.3 1.2-2.2 2.5.1 1.4 1.3 2.4 2.7 2.2 1.2-.1 2.1-1.2 2.1-2.4V3h3.1z"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg>
  {%- when 'pinterest' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 00-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.2-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1012 2z"/></svg>
  {%- when 'x' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
  {%- else -%}
    <svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {%- case name -%}
        {%- when 'cart' -%}<path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 016 0"/>
        {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
        {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
        {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
        {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
        {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
        {%- when 'truck' -%}<path d="M2 6h12v10H2z"/><path d="M14 10h4l4 4v2h-8"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
        {%- when 'shield' -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
        {%- when 'refresh' -%}<path d="M20 11a8 8 0 00-14.5-4.5L3 9"/><path d="M3 4v5h5"/><path d="M4 13a8 8 0 0014.5 4.5L21 15"/><path d="M21 20v-5h-5"/>
        {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
        {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19l7-7"/>
        {%- when 'droplet' -%}<path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/>
        {%- when 'filter' -%}<path d="M3 5h18l-7 8v6l-4 2v-8L3 5z"/>
        {%- when 'quiet' -%}<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9l4 6M21 9l-4 6"/>
        {%- when 'paw' -%}<circle cx="6" cy="10" r="2"/><circle cx="10" cy="6" r="2"/><circle cx="14" cy="6" r="2"/><circle cx="18" cy="10" r="2"/><path d="M8 17c0-2.5 1.8-5 4-5s4 2.5 4 5c0 1.7-1.3 2.5-2.5 2.2-1-.3-2-.3-3 0C9.3 19.5 8 18.7 8 17z"/>
        {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
        {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13"/><path d="M12 8S10.5 3 8 4s0 4 4 4zM12 8s1.5-5 4-4 0 4-4 4z"/>
        {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4V5z"/>
        {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>
        {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
        {%- when 'minus' -%}<path d="M5 12h14"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z"/>
        {%- when 'award' -%}<circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 22l5-3 5 3-1.5-8"/>
        {%- when 'battery' -%}<rect x="2" y="7" width="17" height="10" rx="2"/><path d="M22 11v2"/><path d="M6 10v4M9.5 10v4M13 10v4"/>
        {%- when 'recycle' -%}<path d="M7 19H4.5l3-5.2"/><path d="M17 19h2.5l-3-5.2"/><path d="M9.5 5.5L12 3l2.5 2.5"/><path d="M12 3l3.5 6M12 3L8.5 9M7 19h10"/>
        {%- when 'x-circle' -%}<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>
        {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>
        {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
