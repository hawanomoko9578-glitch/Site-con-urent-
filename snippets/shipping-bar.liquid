{%- if settings.cart_free_shipping_bar -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | times: 100 | round
    assign remaining = threshold | minus: cart.total_price
    if threshold > 0
      assign progress = cart.total_price | times: 100 | divided_by: threshold
    else
      assign progress = 100
    endif
    if progress > 100
      assign progress = 100
    endif
  -%}
  <div class="shipping-bar">
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
    {%- else -%}
      <strong>{{ 'sections.cart.free_shipping_unlocked' | t }}</strong>
    {%- endif -%}
    <div class="shipping-bar__track"><div class="shipping-bar__fill" style="width: {{ progress }}%"></div></div>
  </div>
{%- endif -%}
